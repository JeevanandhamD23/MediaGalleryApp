{
  "all": true,
  "include": [
    "server/lib/**/*.js",
    "server/controller/**/*.js",
    "server/routes/**/*.js",
    "server/middleware/**/*.js",
    "server/presentator/**/*.js",
    "server/db/**/*.js"
  ],
  "exclude": ["server/test/**", "node_modules/**"],
  "reporter": ["text", "html"],
  "check-coverage": true,
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80
}
